{
  "name": "dsh-providers-live-models",
  "version": "0.12.0-rc.34",
  "description": "Live OpenCode and Codex catalogs, isolated OpenDesign sign-in, model routing and subscription balances",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node probe.mjs && node --test test/*.test.mjs test/subscription/*.test.mjs"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs/*.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luca4Don3/dsh-providers-live-models.git"
  },
  "homepage": "https://github.com/Luca4Don3/dsh-providers-live-models",
  "bugs": {
    "url": "https://github.com/Luca4Don3/dsh-providers-live-models/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings-account",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
